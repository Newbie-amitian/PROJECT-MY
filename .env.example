# AI Provider Selection
# Options: 'groq' | 'zai'
# Default: 'zai'
AI_PROVIDER=groq

# Groq API Key (required if AI_PROVIDER=groq)
# Get free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# Optional: Custom Groq model
# Default: llama-3.3-70b-versatile
# Other options: mixtral-8x7b-32768, llama-2-70b-chat
GROQ_MODEL=llama-3.3-70b-versatile

# Z.ai SDK Token (required if AI_PROVIDER=zai)
# For Z.ai SDK usage
ANTHROPIC_AUTH_TOKEN=your_z_ai_token_here

# Vercel Analytics (optional)
VERCEL_WEB_ANALYTICS_ID=

# Analytics / Observability (optional)
SENTRY_DSN=
